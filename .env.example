POSTGRES_DB=expensebot
POSTGRES_USER=expensebot_admin
POSTGRES_PASSWORD=replace-with-a-strong-admin-password
APP_DB_USER=expensebot_app
APP_DB_PASSWORD=replace-with-a-different-strong-app-password
POSTGRES_MAX_POOL_SIZE=20

# Stable public address used to generate the Nginx certificate and register the webhook.
PUBLIC_WEBHOOK_HOST=replace-with-elastic-ip

# Required in Production. Prefer your deployment platform's secret store.
TELEGRAM_TOKEN=replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
